@model IEnumerable<Contrato>

@{
    ViewData["Title"] = "Contratos";
}

<h1>Contratos</h1>

<div class="input-group mb-3">
    <input type="text" class="form-control" placeholder="Buscar..." id="searchInput">
    <div class="input-group-append">
        <a asp-action="Crear" class="btn btn-primary">Crear nuevo</a>
    </div>
</div>
<a asp-action="ContratosVigentes" class="btn btn-primary">Ver Contratos Vigentes</a>
<a asp-action="ContratosFinalizados" class="btn btn-primary">Ver Contratos Finalizados</a>

<div class="col-md-6">
    <div class="card">
        <div class="card-header">Buscar Contratos por fecha limite </div>
        <div class="card-body">
            <form asp-controller="Contrato" asp-action="BuscarPorRango" method="get">
                <div class="form-row">
                    <div class="col">
                        <label for="fechaLimite">Fecha Límite</label>
                        <input type="date" class="form-control" id="fechaLimite" name="fechaLimite" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block mt-3">Buscar</button>
            </form>
        </div>
    </div>
</div>


@if (ViewData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @ViewData["SuccessMessage"]
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdContrato)
            </th>
            <th>
                Fecha Inicio
            </th>
            <th>
                Fecha Finalizacion
            </th>
            <th>
                Monto Alquiler
            </th>
            <th>
                Estado
            </th>
            <th>
                Nombre Inquilino
            </th>
            <th>
                Direccion Inmueble
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdContrato)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaInicio)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FechaFinalizacion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MontoAlquiler)
                </td>
                <td>
                    <input type="checkbox" disabled @(item.Estado ? "checked" : "") />
                </td>
                <td>
                    @(item.Inquilino?.Nombre + " " + item.Inquilino?.Apellido)
                </td>
                <td>
                    @(item.Inmueble?.Direccion)
                </td>

                <td>
                    <a asp-action="Editar" asp-route-idContrato="@item.IdContrato" title="Editar"><span
                            class="fa fa-edit"></span></a>
                    <a asp-action="Detalle" asp-route-IdContrato="@item.IdContrato" title="DetalleContrato"><span
                            class="fa fa-info"></span></a>
                    <a asp-controller="Pago" asp-action="ListarPorContrato" asp-route-idContrato="@item.IdContrato"
                        title="Ver Pagos"><span class="fa fa-money"></span></a>
                    <a asp-action="Renovar" asp-route-idContrato="@item.IdContrato" title="Renovar Contrato"><span
                            class="fa fa-refresh"></span></a>
                    <a asp-action="TerminarContrato" asp-route-idContrato="@item.IdContrato" title="Terminar Contrato">
                        <span class="fa fa-times text-danger"></span></a>

                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Eliminar" asp-route-id="@item.IdContrato" title="Eliminar"
                            onclick="return confirm('¿Estás seguro de eliminar este contrato?');"><span
                                class="fa fa-trash text-danger"></span></a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="~/js/search.js"></script>
}
