@model Inmobiliaria.Models.Contrato
@{
    ViewData["Title"] = "Terminar contrato";
}

<h1>Terminar Contrato</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<form asp-action="RegistrarTerminacion" method="post">
    <input type="hidden" asp-for="IdContrato" />

    <div class="form-group">
        <label>Inquilino</label>
        <input asp-for="Inquilino.Nombre" class="form-control" disabled />
    </div>

    <div class="form-group">
        <label>Inmueble</label>
        <input asp-for="Inmueble.Direccion" class="form-control" disabled />
    </div>
    <div class="form-group">
        <label>Fecha Inicial del Contrato</label>
        <input type="text" class="form-control" value="@Model.FechaInicio.ToString("yyyy-MM-dd HH:mm")" disabled />
    </div>
    <div class="form-group">
        <label>Fecha Original de Finalización</label>
        <input type="text" class="form-control" value="@Model.FechaFinalizacion.ToString("yyyy-MM-dd HH:mm")"
            disabled />
    </div>

    <div class="form-group">
        <label>Fecha Efectiva de Terminación</label>
        <input type="date" id="fechaTerminacion" name="fechaTerminacion" class="form-control" required
            onchange="actualizarPagosAdeudados()" />
    </div>



    <div class="form-group">
        <input type="submit" value="Registrar Terminación" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
<script>
    function actualizarPagosAdeudados() {
        const fechaTerminacion = document.getElementById("fechaTerminacion").value;
        const idContrato = @Model.IdContrato; // Reemplazar con la forma adecuada de pasar el ID del contrato.

        if (fechaTerminacion) {
            $.post('/Contrato/CalcularMesesAdeudados', { idContrato, fechaTerminacion }, function (data) {
                if (data.mesesAdeudados !== undefined) {
                    document.getElementById("pagosAdeudados").value = data.mesesAdeudados;
                } else {
                    alert(data.error || "Error al calcular los pagos adeudados.");
                }
            });
        }
    }
</script>