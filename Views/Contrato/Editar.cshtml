@model Inmobiliaria.Models.Contrato

@{
    ViewData["Title"] = "Editar Contrato";
}

<div class="container mt-5">
    <h4 class="text-primary text-center">Editar Contrato</h4>
    <hr class="mb-4" />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Guardar" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="IdContrato" class="form-label">ID Contrato</label>
                            <input asp-for="IdContrato" class="form-control" readonly />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="FechaInicio" class="form-label">Fecha de Inicio</label>
                            <input asp-for="FechaInicio" class="form-control" required />
                            <span asp-validation-for="FechaInicio" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="FechaFinalizacion" class="form-label">Fecha de Finalización</label>
                            <input asp-for="FechaFinalizacion" class="form-control" required />
                            <span asp-validation-for="FechaFinalizacion" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="MontoAlquiler" class="form-label">Monto de Alquiler</label>
                            <input asp-for="MontoAlquiler" class="form-control" required />
                            <span asp-validation-for="MontoAlquiler" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Estado" class="form-label">Estado</label>
                            <select asp-for="Estado" class="form-control" required>
                                <option value="True">Activo</option>
                                <option value="False">Inactivo</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="IdInquilino" class="form-label">Inquilino</label>
                            <select asp-for="IdInquilino" class="form-control" required>
                                @foreach (var item in ViewBag.Inquilinos)
                                {
                                    <option value="@item.IdInquilino">@($"{item.Nombre} {item.Apellido}")</option>
                                }
                            </select>
                            <span asp-validation-for="IdInquilino" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="IdInmueble" class="form-label">Inmueble</label>
                            <select asp-for="IdInmueble" class="form-control" required>
                                @foreach (var item in ViewBag.Inmuebles)
                                {
                                    <option value="@item.IdInmueble">@($"{item.Direccion}")</option>
                                }
                            </select>
                            <span asp-validation-for="IdInquilino" class="text-danger"></span>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-success w-50">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>

<script src="~/js/validarFechas.js"></script>
