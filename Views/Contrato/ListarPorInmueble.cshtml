@model IEnumerable<Contrato>

<h2>Contratos del Inmueble</h2>

@if (ViewData["NoContractsMessage"] != null)
{
    <div class="alert alert-info" role="alert">
        @ViewData["NoContractsMessage"]
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID Contrato</th>
                <th>Inquilino</th>
                <th>Fecha Inicio</th>
                <th>Fecha Finalización</th>
                <th>Monto Alquiler</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contrato in Model)
            {
                <tr>
                    <td>@contrato.IdContrato</td>
                    <td>@($"{contrato.Inquilino.Nombre} {contrato.Inquilino.Apellido}")</td>
                    <td>@contrato.FechaInicio.ToShortDateString()</td>
                    <td>@contrato.FechaFinalizacion.ToShortDateString()</td>
                    <td>@contrato.MontoAlquiler</td>
                    <td>@(contrato.Estado ? "Activo" : "Inactivo")</td>
                    <td>
                        <a asp-action="Detalle" asp-route-idContrato="@contrato.IdContrato" title="Detalles">
                            <span class="fa fa-info"></span>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
