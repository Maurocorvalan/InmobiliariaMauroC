@model Inmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Pagos";
}

<div class="container mt-5">
    <h4 class="text-primary text-center">Gestión de Pago</h4>
    <hr class="mb-4" />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Guardar" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>
                        <div class="form-group mb-3">
                            <input asp-for="EsMulta" type="hidden" value="@Model.EsMulta" />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="IdPago" class="form-label">ID Pago</label>
                            <input asp-for="IdPago" class="form-control" readonly />

                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="FechaPago" class="form-label">Fecha de Pago</label>
                            <input asp-for="FechaPago" class="form-control" readonly />
                            <span asp-validation-for="FechaPago" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Monto" class="form-label">Monto</label>
                            <input asp-for="Monto" class="form-control" readonly />
                            <span asp-validation-for="Monto" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Detalle" class="form-label">Detalle</label>
                            <input asp-for="Detalle" class="form-control" required />
                            <span asp-validation-for="Detalle" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Estado" class="form-label">Estado</label>
                            <select asp-for="Estado" class="form-control" required>
                                <option value="True" selected>Pagado</option>
                                <option value="False">Anulado</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="IdContrato" class="form-label">Contrato (Elegir)</label>
                            <select asp-for="IdContrato" class="form-control" readonly>
                                @foreach (var item in ViewBag.Contratos)
                                {
                                    <option value="@item.IdContrato">@(item.ToString())</option>
                                }
                            </select>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-success w-50">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>
