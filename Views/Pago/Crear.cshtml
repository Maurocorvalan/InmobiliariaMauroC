@model Inmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Pagos";
    int id = Model == null ? 0 : Model.IdPago;
}

<h4>Pagos</h4>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Guardar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IdContrato" class="control-label">Contrato</label>
                <select asp-for="IdContrato" id="contratoSelect" class="form-control" required>
                    <option value="">Seleccione un contrato</option>
                    @foreach (var contrato in ViewBag.Contratos)
                    {
                        <option value="@contrato.IdContrato" data-monto="@contrato.MontoAlquiler">
                            @contrato.Descripcion
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label asp-for="FechaPago" class="control-label"></label>
                <input asp-for="FechaPago" class="form-control" required />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Monto" class="control-label"></label>
                <input asp-for="Monto" id="montoInput" class="form-control"  readonly />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Detalle" class="control-label"></label>
                <input asp-for="Detalle" class="form-control" required />
                <span asp-validation-for="Detalle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Estado" class="control-label">Estado (Elegir)</label>
                <select asp-for="Estado" class="form-control" required>
                    <option value="true">Pagado</option>
                    <option value="false">Anulado</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>


<script>
    document.getElementById('contratoSelect').addEventListener('change', function () {
        const selectedOption = this.options[this.selectedIndex];
        const monto = selectedOption.getAttribute('data-monto');
        document.getElementById('montoInput').value = monto || '';
    });
</script>
