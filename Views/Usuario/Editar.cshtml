@model Inmobiliaria.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}
@if (User.IsInRole("Administrador") || Model.IdUsuario.ToString() == User.FindFirst("IdUsuario")?.Value)
{
    @if (ViewData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center mt-3" role="alert">
            @ViewData["SuccessMessage"]
        </div>
    }
    else if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center mt-3" role="alert">
            @ViewData["ErrorMessage"]
        </div>
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item mx-2">
                        <button type="button" class="btn btn-outline-light" onclick="mostrarEditarFoto()">Editar Avatar</button>
                    </li>
                    <li class="nav-item mx-2">
                        <button type="button" class="btn btn-outline-light" onclick="mostrarEditarDatos()">Editar Datos</button>
                    </li>
                    <li class="nav-item mx-2">
                        <button type="button" class="btn btn-outline-light" onclick="mostrarCambiarContraseña()">Cambiar Contraseña</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div id="editarFotoForm" style="display:none;" class="container">
        <div class="card shadow mb-4">
            <div class="card-header text-white bg-primary">
                <h5 class="mb-0">Editar Avatar</h5>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" id="avatar-preview" alt="Avatar" class="img-thumbnail" style="max-width: 150px;">
                    }
                    else
                    {
                        <p>No hay avatar disponible.</p>
                    }
                </div>
                <form id="avatarForm" asp-action="EditarAvatar" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="AvatarFile" class="form-label">Selecciona una imagen</label>
                        <input type="file" name="AvatarFile" id="avatar" class="form-control" accept="image/*">
                        <span asp-validation-for="AvatarFile" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-success">Guardar Cambios</button>
                        <button type="submit" class="btn btn-danger" onclick="return confirm('¿Estás seguro de eliminar tu avatar?')">Eliminar Avatar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="editarDatosForm" style="display:none;" class="container">
        <div class="card shadow mb-4">
            <div class="card-header text-white bg-primary">
                <h5 class="mb-0">Editar Datos</h5>
            </div>
            <div class="card-body">
                <form asp-action="EditarDatos" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Apellido" class="form-label">Apellido</label>
                        <input asp-for="Apellido" class="form-control" />
                    </div>
                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label">Rol</label>
                            <select asp-for="Rol" class="form-control">
                                <option value="Administrador">Administrador</option>
                                <option value="Empleado">Empleado</option>
                            </select>
                        </div>
                    }
                    <div class="mb-3">
                        <label for="claveActual" class="form-label">Contraseña Actual</label>
                        <input id="claveActual" class="form-control" type="password" name="claveActual" required />
                    </div>
                    <button type="submit" class="btn btn-success">Guardar Cambios</button>
                </form>
            </div>
        </div>
    </div>

    <div id="cambiarContraseñaForm" style="display:none;" class="container">
        <div class="card shadow mb-4">
            <div class="card-header text-white bg-primary">
                <h5 class="mb-0">Cambiar Contraseña</h5>
            </div>
            <div class="card-body">
                <form asp-action="CambiarClave" method="post">
                    <div class="mb-3">
                        <label for="ClaveActual" class="form-label">Contraseña Actual</label>
                        <input id="ClaveActual" class="form-control" type="password" name="claveActual" required />
                    </div>
                    <div class="mb-3">
                        <label for="claveNueva" class="form-label">Nueva Contraseña</label>
                        <input id="claveNueva" class="form-control" type="password" name="claveNueva" required />
                    </div>
                    <div class="mb-3">
                        <label for="claveConfirmar" class="form-label">Confirmar Nueva Contraseña</label>
                        <input id="claveConfirmar" class="form-control" type="password" name="claveConfirmar" required />
                    </div>
                    <button type="submit" class="btn btn-success">Guardar Cambios</button>
                </form>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
}
else
{
    <div class="alert alert-warning text-center mt-5" role="alert">
        No tienes acceso.
    </div>
}
