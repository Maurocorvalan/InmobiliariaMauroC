@model Inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
    int id = Model == null ? 0 : Model.IdInmueble;
}

<div class="container mt-5">
    <h4 class="text-primary text-center">Editar Inmueble</h4>
    <hr class="mb-4" />
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Guardar" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="IdInmueble" class="form-label">Código</label>
                            <input asp-for="IdInmueble" class="form-control bg-light text-muted" readonly />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Direccion" class="form-label">Dirección</label>
                            <input asp-for="Direccion" class="form-control" required />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Uso" class="form-label">Uso (Elegir)</label>
                            <select asp-for="Uso" class="form-control" required>
                                <option value="Residencial">Residencial</option>
                                <option value="Comercial">Comercial</option>
                            </select>
                            <span asp-validation-for="Uso" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Tipo" class="form-label">Tipo (Elegir)</label>
                            <select asp-for="Tipo" class="form-control" required>
                                <option value="Casa">Casa</option>
                                <option value="Departamento">Departamento</option>
                                <option value="Local Comercial">Local Comercial</option>
                                <option value="Oficina">Oficina</option>
                            </select>
                            <span asp-validation-for="Tipo" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Ambientes" class="form-label">Ambientes</label>
                            <input asp-for="Ambientes" class="form-control" required />
                            <span asp-validation-for="Ambientes" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Superficie" class="form-label">Superficie</label>
                            <input asp-for="Superficie" class="form-control" required />
                            <span asp-validation-for="Superficie" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Valor" class="form-label">Valor</label>
                            <input asp-for="Valor" class="form-control" required />
                            <span asp-validation-for="Valor" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Latitud" class="form-label">Latitud</label>
                            <input asp-for="Latitud" class="form-control" required />
                            <span asp-validation-for="Latitud" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Longitud" class="form-label">Longitud</label>
                            <input asp-for="Longitud" class="form-control" required />
                            <span asp-validation-for="Longitud" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Disponible" class="form-label">¿Disponible?</label>
                            <select asp-for="Disponible" class="form-control">
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                            <span asp-validation-for="Disponible" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="IdPropietario" class="form-label">Propietario (Elegir)</label>
                            <select asp-for="IdPropietario" class="form-control" required>
                                @foreach (var item in ViewBag.Propietarios)
                                {
                                 @:<option @(item.IdPropietario == Model?.IdPropietario ? "selected" : "") value="@item.IdPropietario">@(item.Nombre + " " + item.Apellido)</option>

                                }
                            </select>
                            <span asp-validation-for="IdPropietario" class="text-danger"></span>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-success w-50">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (ViewData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center mt-4" role="alert">
            @ViewData["SuccessMessage"]
        </div>
    }
    else if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center mt-4" role="alert">
            @ViewData["ErrorMessage"]
        </div>
    }

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>
