@model IEnumerable<Inmueble>
    @{
    ViewData["Title"] = "Inmuebles Disponibles";
}

<h1>Inmuebles Disponibles</h1>

@if (ViewData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @ViewData["SuccessMessage"]
    </div>
}
<div class="input-group mb-3">
    <input type="text" class="form-control" placeholder="Buscar..." id="searchInput">

</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Dirección</th>
            <th>Uso</th>
            <th>Tipo</th>
            <th>Valor</th>
            <th>Propietario</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inmueble in Model)
        {
            <tr>
                <td>@inmueble.IdInmueble</td>
                <td>@inmueble.Direccion</td>
                <td>@inmueble.Uso</td>
                <td>@inmueble.Tipo</td>
                <td>@inmueble.Valor</td>
                <td>@inmueble.Duenio.Nombre @inmueble.Duenio.Apellido</td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="~/js/search.js"></script>
}
