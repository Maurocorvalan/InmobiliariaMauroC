@model IEnumerable<Inmueble>

@{
    ViewData["Title"] = "Inmueble";
}

<h1 class="mb-4">Inmuebles</h1>

<div class="row mb-4">
    <!-- Buscar Inmuebles -->
    <div class="col-md-8">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Buscar..." id="searchInput">
            <div class="input-group-append">
                <a asp-action="Crear" class="btn btn-primary">Crear nuevo</a>
            </div>
        </div>
    </div>
    <!-- Ver Disponibles -->
    <div class="col-md-4 text-right">
        <a asp-controller="Inmueble" asp-action="Disponibles" class="btn btn-primary">Ver Inmuebles Disponibles</a>
    </div>
</div>

@if (ViewData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @ViewData["SuccessMessage"]
    </div>
}

<!-- Formularios -->
<div class="row">
    <!-- Buscar por Propietario -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Buscar por Propietario</div>
            <div class="card-body">
                <form asp-controller="Inmueble" asp-action="DisponiblesPorPropietario" method="get">
                    <div class="form-group">
                        <label for="idPropietario">Seleccionar Propietario</label>
                        <select id="idPropietario" name="idPropietario" class="form-control" required>
                            @foreach (var propietario in ViewBag.Propietarios)
                            {
                                <option value="@propietario.IdPropietario">
                                    @($"{propietario.Nombre} {propietario.Apellido}")
                                </option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Buscar</button>
                </form>
            </div>
        </div>
    </div>
    <!-- Buscar por Fechas -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Buscar por Fechas</div>
            <div class="card-body">
                <form asp-controller="Inmueble" asp-action="DisponiblesPorFechas" method="get">
                    <div class="form-row">
                        <div class="col">
                            <label for="fechaInicio">Fecha Inicio</label>
                            <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" required>
                        </div>
                        <div class="col">
                            <label for="fechaFin">Fecha Fin</label>
                            <input type="date" class="form-control" id="fechaFin" name="fechaFin" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block mt-3">Buscar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Inmuebles -->
<div class="table-responsive mt-4">
    <table class="table table-striped">
        <thead class="thead-light">
            <tr>
                <th>Dirección</th>
                <th>@Html.DisplayNameFor(model => model.Uso)</th>
                <th>@Html.DisplayNameFor(model => model.Tipo)</th>
                <th>@Html.DisplayNameFor(model => model.Ambientes)</th>
                <th>Dueño</th>
                <th>@Html.DisplayNameFor(model => model.Valor)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                    <td>@Html.DisplayFor(modelItem => item.Uso)</td>
                    <td>@Html.DisplayFor(modelItem => item.Tipo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Ambientes)</td>
                    <td>@(item.Duenio?.Nombre + " " + item.Duenio?.Apellido)</td>
                    <td>@Html.DisplayFor(model => item.Valor)</td>
                    <td>
                        <a asp-action="Editar" asp-route-idInmueble="@item.IdInmueble" title="Editar"><span
                                class="fa fa-edit"></span></a>
                        <a asp-action="Detalle" asp-route-IdInmueble="@item.IdInmueble" title="DetallePropietario"><span
                                class="fa fa-info"></span></a>

                        <a asp-controller="Contrato" asp-action="ListarPorInmueble" asp-route-idInmueble="@item.IdInmueble"
                            title="Listar Contratos" class="fa fa-file">
                        </a>


                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Eliminar" asp-route-id="@item.IdInmueble" title="Eliminar"
                                onclick="return confirm('¿Estás seguro de eliminar a @item.Tipo @item.Uso @item.Direccion?');"><span
                                    class="fa fa-trash text-danger"></span></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="~/js/search.js"></script>
}
